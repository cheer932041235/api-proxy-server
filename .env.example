# === 上游 API 配置 ===
# 你自己购买的官方 API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com

# Anthropic（可选）
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# === 反代配置 ===
# 反代对外暴露的 Key（你在编辑器里填的 Key）
PROXY_API_KEY=sk-proxy-your-custom-key-here

# 监听端口
PROXY_PORT=3001

# === 日志 ===
LOG_FILE=logs/usage.csv
LOG_LEVEL=INFO

# === VPS 信息（部署时用） ===
VPS_HOST=待填写
VPS_USER=root
VPS_SSH_PORT=22
DOMAIN=待填写
