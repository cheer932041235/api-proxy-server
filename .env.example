# ============================================================
# API Proxy Server - 环境变量模板
# 复制为 .env 后填入你的真实值。.env 已被 gitignore，不会上传。
# 使用：cp .env.example .env && vim .env
# ============================================================

# ===== VPS / 域名 =====
VPS_HOST=your.vps.ip.here              # 你的 VPS 公网 IP
VPS_USER=root                          # SSH 用户
VPS_SSH_ALIAS=vps                      # ~/.ssh/config 中的别名（可选）
DOMAIN=api.example.com                 # 你的域名（需要先解析到 VPS_HOST）
SSL_EMAIL=you@example.com              # Let's Encrypt 通知邮箱

# ===== 服务端口 =====
PORT_NEW_API=3001
PORT_CHATGPT2API=3002
PORT_CODEX_PROXY=8080
PORT_CODEX_OAUTH_CALLBACK=1457         # codex-proxy OAuth 回调端口
PORT_IMAGE_GEN=8088
PORT_CODEX_LOG_VIEWER=8089

# ===== 服务密钥（请改成强随机值！）=====
NEW_API_ADMIN_USER=root
NEW_API_ADMIN_PASS=ChangeMe_StrongPwd_!@#
NEW_API_KEY=sk-ChangeMe_GenerateAFreshOne

CHATGPT2API_AUTH_KEY=sk-ChangeMe_chatgpt2api_internal
CODEX_PROXY_API_KEY=ChangeMe_codex_key
CODEX_LOG_VIEWER_TOKEN=ChangeMe_log_token

# ===== Docker 镜像（一般不用改）=====
IMAGE_NEW_API=calciumion/new-api:latest
IMAGE_CHATGPT2API=ghcr.io/basketikun/chatgpt2api:latest
IMAGE_CODEX_PROXY=ghcr.io/icebear0828/codex-proxy:latest

# ===== 数据持久化路径（VPS 上的目录）=====
DATA_ROOT=/root
DATA_NEW_API=${DATA_ROOT}/new-api-data
DATA_CHATGPT2API=${DATA_ROOT}/chatgpt2api-data
DATA_CODEX_PROXY=${DATA_ROOT}/codex-proxy/data
DATA_BACKUPS=${DATA_ROOT}/backups
BACKUP_KEEP_DAYS=7

# ===== 邮件告警（可选，留空则不发邮件）=====
ALERT_RECIPIENT=                       # 接收告警的邮箱（留空禁用）
SMTP_HOST=smtp.qq.com                  # QQ / 163 / Gmail 等
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                             # 授权码 / app password

# ===== 配图工具：访问解锁（可选）=====
# 学员可以改成自己的"项目密码"，留空则关闭解锁功能
STUDIO_QUIZ_QUESTION=请输入访问密码
STUDIO_QUIZ_ANSWER=ChangeMe_studio_pass
STUDIO_RATE_LIMIT_MAX=6                # 每窗口最多请求数
STUDIO_RATE_LIMIT_WINDOW_MIN=5         # 窗口长度（分钟）

# ===== Codex CLI 默认 API Key（公开访问端点用的简单 key）=====
# 这是给学员/朋友共享时用的"低门槛 key"，可以改成更长的随机串
CODEX_PUBLIC_KEY=pwd
